# Managed Insights credential: used when the client does not send its own key
map $http_authorization $intel_auth {
    default $http_authorization;
    ""      "Bearer {{ insights_api_key }}";
}

# HTTP - redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name }};
    return 301 https://$server_name$request_uri;
}

# HTTPS - static SPA
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain_name }};

    # Cloudflare Origin Certificate (wildcard *.bayabotech.com)
    ssl_certificate /etc/ssl/cloudflare/cert.pem;
    ssl_certificate_key /etc/ssl/cloudflare/key.pem;

    root {{ app_path }};
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Hashed build assets — cache forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # APK / downloads — never cache (so a rebuilt field app is delivered
    # immediately, not a stale CDN/browser copy). no-store also stops Cloudflare
    # from edge-caching the octet-stream.
    location /downloads/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires -1;
    }

    # GM-MIS API — same-origin reverse proxy to the NestJS backend (auth, cases,
    # users, settings, audit, OTP, notifications, insights). The SPA calls /api
    # so the browser never makes a cross-site request.
    location /api/ {
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 12m;
    }

    # Insights engine — legacy same-origin proxy to the analysis provider
    # (retained for backward compatibility; primary path is /api/insights/chat)
    location /intel/ {
        proxy_pass https://api.deepseek.com/;
        proxy_ssl_server_name on;
        proxy_set_header Host api.deepseek.com;
        proxy_set_header Authorization $intel_auth;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }
}
